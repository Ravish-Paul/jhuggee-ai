# Site configuration — variable names only, no secrets.
# Copy to .env.local for local development.

# Canonical origin used for SEO metadata, sitemap, robots.txt and Open Graph.
# Set this to your verified domain before launch. Example: https://www.jhuggee.ai
NEXT_PUBLIC_SITE_URL=

# Verified business contact address. Shown in the FAQ and waitlist success state.
# Leave empty to hide contact details until a mailbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=

# Waitlist storage (Supabase). Leave both empty to run in documented demo mode:
# signups are validated server-side but NOT stored, and the UI says so honestly.
# Create the table with docs/supabase-schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for the future voice provider (never used in the browser, never
# prefixed with NEXT_PUBLIC_). The interactive demo is a local simulation today.
# VOICE_PROVIDER_API_KEY=
